    },
    {
      "kind": "text",
      "text": "The course contact hours of CSE 200 have been corrected.",
      "links": [
        {
          "text": "CSE 200",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/creative-school-experience/CSE/200/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The course description of BPM 905 has been revised to indicate that the course was formerly RTA 905.",
      "links": [
        {
          "text": "BPM 905",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/professional-music/BPM/905/"
