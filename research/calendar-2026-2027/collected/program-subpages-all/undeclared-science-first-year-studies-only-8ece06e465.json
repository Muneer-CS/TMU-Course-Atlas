    {
      "kind": "heading",
      "level": 2,
      "text": "Undeclared Science - First Year Studies Only"
    },
    {
      "kind": "text",
      "text": "Administered by:"
    },
    {
      "kind": "text",
      "text": "Faculty of Science",
      "links": [
        {
          "text": "Faculty of Science",
          "url": "https://www.torontomu.ca/content/ryerson/science/"
