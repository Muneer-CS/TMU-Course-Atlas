  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Image Arts Core Elective Table I"
    },
    {
      "kind": "text",
      "text": "Image Arts",
      "links": [
        {
          "text": "Image Arts",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/fcad/image_arts/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Available only to the following students: Photography Media Arts students admitted Fall 2024 and before. Film students admitted Fall 2025 and before."
    },
    {
      "kind": "text",
      "text": "Photography Media Arts students admitted Fall 2025 and after please see Photography Media Arts Table I .",
      "links": [
        {
          "text": "Photography Media Arts Table I",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/fcad/image_arts/photomedia_table_i/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Film students admitted Fall 2026 and after please see Film Table I .",
      "links": [
        {
          "text": "Film Table I",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/fcad/image_arts/film-table-i/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Students must complete a total of three single-term courses (or equivalent) from Table I, between 5th & 8th semester."
    },
