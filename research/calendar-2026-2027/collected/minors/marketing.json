          "text": "RMG 302",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/retail-management/RMG/302/"
        }
      ]
    },
    {
      "kind": "list_item",
      "text": "MKT 500 Marketing Research or HTR 741 Hospitality and Tourism Research Concepts or RMG 700 Applied Retail Research",
