        {
          "text": "CRB 100",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/caribbean-studies/CRB/100/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Plus five (5) of the following:"
