    {
      "kind": "text",
      "text": "The Minor in Performance is designed for students who are interested in live performance and who seek the opportunity to explore topics through the prescribed course work of a minor. Students are advised to consult with the School of Performance Academic Coordinator before commencing courses in the Minor."
    },
    {
      "kind": "text",
      "text": "Administered by: School of Performance"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
