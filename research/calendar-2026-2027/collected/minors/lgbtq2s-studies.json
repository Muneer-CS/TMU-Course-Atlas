  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in LGBTQ2S+ Studies"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The LGBTQ2S+ Studies Minor provides students with an interdisciplinary, intersectional approach to exploring the Canadian and international histories and cultures of LGBTQ2S+ identities, communities, anti-LGBTQ2S+ attitudes and actions, and strategies of LGBTQ2S+ resistance."
    },
    {
      "kind": "text",
      "text": "Administered by: Department of Sociology"
    },
    {
      "kind": "text",
      "text": "Exclusions: Students may use a maximum of two (2) courses in any given discipline (indicated by the subject prefix of the course code; for History courses this means that students may use a maximum of two (2) HIS/HST courses towards completion of the minor.)"
    },
    {
      "kind": "text",
      "text": "To receive this Minor, students must complete six (6) courses in total including:"
    },
    {
      "kind": "text",
      "text": "One (1) the following courses:"
    },
    {
      "kind": "list_item",
      "text": "HST 375 LGBTQ2S+ Histories",
      "links": [
        {
          "text": "HST 375",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/history/HST/375/"
        }
      ]
    },
    {
      "kind": "list_item",
      "text": "PHL 320 Queer Theory",
      "links": [
        {
          "text": "PHL 320",
