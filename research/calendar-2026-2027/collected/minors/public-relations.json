  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Public Relations"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The Minor in Public Relations will help students understand the role of Public Relations experts as they negotiate between the organizations they represent and the media. Through theory and practice, students will gain experience in the tools and ways of thinking that shape stakeholder relationships."
    },
    {
      "kind": "text",
      "text": "Administered by: School of Professional Communication and offered in collaboration with the School of Journalism"
    },
    {
      "kind": "text",
      "text": "Exclusions: This Minor cannot be taken in conjunction with the Minor in Professional Communication or the News Studies Minor.",
      "links": [
        {
          "text": "Professional Communication",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/pro_comm_minor/"
        },
        {
          "text": "News Studies",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/news_studies_minor/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "To receive this Minor, you must complete six (6) courses from the following curriculum:"
    },
    {
      "kind": "text",
      "text": "Two (2) courses:"
    },
    {
      "kind": "text",
      "text": "One of the following:"
    },
    {
      "kind": "list_item",
      "text": "CMN 200 Introduction to Professional Writing",
      "links": [
        {
          "text": "CMN 200",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/communication/CMN/200/"
        }
      ]
    },
    {
      "kind": "list_item",
      "text": "CMN 279 * Introduction to Professional Communication",
      "links": [
        {
          "text": "CMN 279",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/communication/CMN/279/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Plus:"
    },
    {
      "kind": "list_item",
      "text": "CMN 305 Strategic Public Relations in ProCom",
      "links": [
        {
          "text": "CMN 305",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/communication/CMN/305/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Plus four (4) electives from the following:"
    },
