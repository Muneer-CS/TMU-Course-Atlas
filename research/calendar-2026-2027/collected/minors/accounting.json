  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Accounting"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The Minor in Accounting will offer future business managers and entrepreneurs an understanding of the accounting functions of a business. Courses selected for this Minor are intended to focus on the needs of managers and entrepreneurs."
    },
    {
      "kind": "text",
      "text": "Administered by: School of Accounting and Finance at the Ted Rogers School of Management"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Accounting and Finance, all majors",
      "links": [
        {
          "text": "Accounting and Finance, all majors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/trsm/accounting_finance/"
        }
      ]
    },
    {
      "kind": "list_item",
      "text": "Business Management, Accounting Major"
    },
    {
      "kind": "list_item",
      "text": "Business Management, Finance Major"
    },
    {
      "kind": "list_item",
      "text": "Business Management, Law and Business Major",
      "links": [
        {
          "text": "Business Management, Law and Business Major",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/trsm/business_mgt/law_business_major/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "To receive this Minor, students must complete six (6) courses from the following curriculum:"
    },
    {
      "kind": "text",
      "text": "Three (3) Required courses:"
    },
    {
      "kind": "list_item",
      "text": "ACC 100 Introductory Financial Accounting or ACC 110 Financial Accounting or AFA 100 Introductory Financial Accounting",
      "links": [
        {
          "text": "ACC 100",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/accounting/ACC/100/"
        },
        {
          "text": "ACC 110",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/accounting/ACC/110/"
        },
        {
          "text": "AFA 100",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/accounting/AFA/100/"
        }
      ]
    },
    {
      "kind": "list_item",
      "text": "ACC 406 Introductory Management Accounting or ACC 410 Management Accounting or AFA 200 Introductory Management Accounting",
      "links": [
        {
          "text": "ACC 406",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/accounting/ACC/406/"
        },
        {
          "text": "ACC 410",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/accounting/ACC/410/"
        },
        {
          "text": "AFA 200",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/accounting/AFA/200/"
        }
      ]
    },
    {
      "kind": "list_item",
      "text": "AFA 620 Data Analytics and Info Systems",
      "links": [
        {
          "text": "AFA 620",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/accounting/AFA/620/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Plus three (3) of the following:"
    },
    {
