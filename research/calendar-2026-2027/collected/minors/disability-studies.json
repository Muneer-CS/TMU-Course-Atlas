  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Disability Studies"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The Minor in Disability Studies allows students to explore key issues and debates related to disability. Starting from the perspectives of disabled and mad people, courses highlight advocacy, social transformation and equity. Curriculum is intended to build expertise around accessibility, ethics, law, arts, literature, design, technology, health, social care, rights and justice. Students are encouraged to build a minor that complements and extends their discipline."
    },
    {
      "kind": "text",
      "text": "Administered by: School of Disability Studies"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Disability Studies",
      "links": [
        {
          "text": "Disability Studies",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/community/disability_studies/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "To receive this Minor, students must complete six (6) courses from the following curriculum:"
    },
    {
      "kind": "text",
      "text": "One* (1) of the following:"
    },
