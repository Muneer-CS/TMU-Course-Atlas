  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Visual Studies"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The Visual Studies Minor is a lecture-based overview of the history and theories of this interdisciplinary field. Courses introduce students to the field by providing a solid foundation in visual culture, art history and contemporary theory. A broad range of current visual culture examples enhance learning and make the study relevant to everyday experiences. Students will explore the social, economic and cultural dimensions of the image-based world that surrounds us."
    },
    {
      "kind": "text",
      "text": "Administered by: School of Image Arts"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Image Arts - all options",
      "links": [
        {
          "text": "Image Arts",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/fcad/image_arts/"
        }
      ]
    },
