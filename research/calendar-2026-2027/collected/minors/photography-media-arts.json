  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Photography Media Arts"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The Minor in Photography Media Arts provides students with a mixture of hands-on, studio-based instruction combined with lecture-based, theory and history courses. In this way, students are able to acquire skills and techniques associated with photographic practice while also becoming familiar with the concepts, ideas, and aesthetics connected to photography and contemporary art."
    },
    {
      "kind": "text",
      "text": "Administered by: School of Image Arts"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Image Arts, Photography Media Arts",
      "links": [
        {
          "text": "Image Arts, Photography Media Arts",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/fcad/image_arts/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "To receive this Minor, students must complete six (6) courses from the following curriculum:"
