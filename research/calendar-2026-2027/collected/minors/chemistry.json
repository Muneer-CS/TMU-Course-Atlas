  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Chemistry"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The objective of the Minor in Chemistry is to provide students with the opportunity to gain additional knowledge and skills in chemistry, and at the same time, provide additional options for students still wishing to have an emphasis in another field of science (e.g. Biology). This Minor is also intended to provide students with additional qualifications, thereby enhancing their options in science-related careers and graduate studies, particularly in fields such as biotechnology and the environmental sciences."
    },
    {
      "kind": "text",
      "text": "Administered by: Department of Chemistry and Biology"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Chemistry - all options",
      "links": [
        {
          "text": "Chemistry",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/science/chemistry/"
        }
      ]
    },
    {
      "kind": "text",
