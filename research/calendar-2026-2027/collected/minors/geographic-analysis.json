      "links": [
        {
          "text": "GEO 719",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/geography/GEO/719/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Plus four (4) of the following:"
    },
