  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Professional Communication"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "High-level competency in written, oral, and visual communication is increasingly recognized as vital to success in business and the public sector. The Minor in Professional Communication develops students' communication professionalism through theoretical and workshop courses emphasizing creative, workable solutions to challenging communication problems."
    },
    {
      "kind": "text",
      "text": "Administered by: School of Professional Communication"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Professional Communication",
      "links": [
        {
          "text": "Professional Communication",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/fcad/procomm/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "This minor cannot be taken in conjunction with the Public Relations Minor."
    },
    {
      "kind": "text",
      "text": "To receive this Minor, students must complete six (6) courses from the following curriculum:"
    },
    {
      "kind": "text",
      "text": "Required course (1):"
    },
    {
      "kind": "list_item",
      "text": "CMN 279 * Introduction to Professional Communication",
      "links": [
        {
          "text": "CMN 279",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/communication/CMN/279/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Plus five (5) of the following:"
    },
