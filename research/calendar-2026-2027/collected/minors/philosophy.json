  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Philosophy"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The Philosophy Minor provides the opportunity for students to engage with the most fundamental questions of human existence and develop essential skills in critical thinking, clear writing, analysis and argument. A Minor in Philosophy enhances career possibilities in a number of different areas, including the teaching profession, law, journalism, business, government and health and community services."
    },
    {
      "kind": "text",
      "text": "Administered by: Department of Philosophy"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Arts and Contemporary Studies, Philosophy Option",
      "links": [
        {
          "text": "Arts and Contemporary Studies, Philosophy Option",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/arts/arts_contemporary/"
        }
      ]
    },
    {
