      "links": [
        {
          "text": "CPS 209",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/computer-science/CPS/209/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Plus four (4) of the following:"
    },
    {
      "kind": "text",
      "text": "Students must select any four courses from the following list:"
