  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Finance"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The Finance Minor will help to prepare students for careers in financial institutions and business."
    },
    {
      "kind": "text",
      "text": "Administered by: School of Accounting and Finance at the Ted Rogers School of Management"
    },
    {
      "kind": "text",
      "text": "Students that have completed AFF courses and are no longer registered in the School of Accounting and Finance may use certain AFF courses in place of FIN courses, if applicable and approved by the department, for the completion of the Minor."
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Accounting and Finance - all majors",
      "links": [
        {
          "text": "Accounting and Finance - all majors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/trsm/accounting_finance/"
        }
      ]
    },
    {
      "kind": "list_item",
      "text": "Financial Mathematics",
      "links": [
        {
          "text": "Financial Mathematics",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/science/financial_math/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "To receive this Minor, students must complete six (6) courses from the following curriculum:"
    },
