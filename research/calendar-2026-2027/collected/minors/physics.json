  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Physics"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
