  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Family Supports and Community Practice"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The Minor in Family Supports and Community Practice is designed to focus on the theme of the Family in Community Context and the methods of Interdisciplinary Practice."
    },
    {
      "kind": "text",
      "text": "Administered by: School of Early Childhood Studies and the School of Nutrition"
    },
    {
      "kind": "text",
      "text": "To receive this Minor, students must complete six (6) courses from the following curriculum:"
    },
    {
      "kind": "text",
      "text": "Required course (1):"
    },
    {
      "kind": "list_item",
      "text": "CLD 435 Theory and Practice of Family Support",
      "links": [
        {
          "text": "CLD 435",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/early-childhood-studies/CLD/435/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "Plus five (5) of the following*:"
