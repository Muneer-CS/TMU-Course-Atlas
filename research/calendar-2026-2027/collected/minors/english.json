  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in English"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The English Minor provides students with a course of study that focuses on how to read and write critically – that is, analyze, historicize, and politicize literary and cultural texts. Understanding the complexities of texts and their influence in a variety of forms, media, time periods and cultural contexts adds depth and breadth to students' program of study and enhances their career possibilities."
    },
    {
      "kind": "text",
      "text": "Administered by: Department of English"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Arts and Contemporary Studies - English Option",
      "links": [
        {
