  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Minor in Psychology"
    },
    {
      "kind": "text",
      "text": "Minors",
      "links": [
        {
          "text": "Minors",
          "url": "https://www.torontomu.ca/calendar/2026-2027/minors/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "The Minor in Psychology complements students' professional studies in a wide range of disciplines and broadens their career preparation. Students acquire an understanding and application of the basic principles of psychology."
    },
    {
      "kind": "text",
      "text": "Administered by: Department of Psychology"
    },
    {
      "kind": "text",
      "text": "Exclusions: This minor is not available to students in the following programs:"
    },
    {
      "kind": "list_item",
      "text": "Psychology",
      "links": [
        {
          "text": "Psychology",
          "url": "https://www.torontomu.ca/calendar/2026-2027/programs/arts/psychology/"
        }
      ]
    },
    {
      "kind": "text",
      "text": "To receive this Minor, students must complete six (6) courses from the following curriculum:"
    },
    {
      "kind": "text",
      "text": "Required courses (2):"
    },
    {
      "kind": "list_item",
      "text": "PSY 102 Introduction to Psychology I or PSY 105 Foundations of Psychology",
      "links": [
        {
          "text": "PSY 102",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/psychology/PSY/102/"
        },
        {
          "text": "PSY 105",
          "url": "https://www.torontomu.ca/calendar/2026-2027/courses/psychology/PSY/105/"
        }
      ]
